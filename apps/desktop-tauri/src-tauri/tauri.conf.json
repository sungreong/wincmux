{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinCMux Tauri",
  "identifier": "ai.manaflow.wincmux.tauri",
  "version": "0.2.94",
  "build": {
    "beforeDevCommand": "node scripts/build-runtime.mjs --debug",
    "beforeBuildCommand": "node scripts/build-runtime.mjs",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinCMux Tauri",
        "width": 1600,
        "height": 980,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icon-terminal.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/wincmux-core",
      "binaries/wincmux-capture"
    ],
    "resources": {
      "../../../bridge/mcp/server.cjs": "mcp/server.cjs"
    }
  }
}
