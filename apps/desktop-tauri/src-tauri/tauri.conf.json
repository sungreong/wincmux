{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinCMux Tauri",
  "identifier": "ai.manaflow.wincmux.tauri",
  "version": "0.1.4",
  "build": {
    "beforeDevCommand": "node scripts/build-ui.mjs",
    "beforeBuildCommand": "node scripts/build-ui.mjs",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "WinCMux Tauri", "width": 1600, "height": 980, "visible": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon-terminal.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
