{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wincmux.dev/schemas/jsonrpc.request.schema.json",
  "title": "WinCMux JSON-RPC Request",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "health.check",
        "workspace.create",
        "workspace.list",
        "workspace.rename",
        "workspace.delete",
        "workspace.pin",
        "workspace.reorder",
        "session.run",
        "session.list",
        "session.close",
        "session.resize",
        "session.write",
        "session.read",
        "notify.push",
        "notify.unread",
        "notify.mark_read",
        "notify.clear",
        "layout.split",
        "layout.focus",
        "layout.list",
        "runtime.info",
        "runtime.shutdown",
        "runtime.shutdown_all",
        "runtime.prepare_update",
        "runtime.cancel_update",
        "runtime.activate",
        "client.attach",
        "client.context",
        "client.detach",
        "client.activation_ack",
        "session.snapshot",
        "session.tail",
        "session.stream.subscribe",
        "session.stream.unsubscribe",
        "agent.list",
        "agent.acknowledge",
        "hidden.list",
        "hidden.add",
        "hidden.remove",
        "notify.get"
      ]
    },
    "params": {
      "type": [
        "object",
        "array",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
