{
  "name": "wincmux",
  "version": "0.2.134",
  "private": true,
  "description": "WinCMux Windows terminal workspace powered by Tauri and Rust",
  "scripts": {
    "dev": "cd apps/desktop-tauri && tauri dev",
    "build:ui": "node apps/desktop-tauri/scripts/build-ui.mjs",
    "build": "cd apps/desktop-tauri && tauri build --no-bundle",
    "pretest": "node apps/desktop-tauri/scripts/build-runtime.mjs",
    "test": "node --test apps/desktop-tauri/tests/adapter.test.cjs apps/desktop-tauri/tests/output-resize.test.cjs apps/desktop-tauri/tests/launch-profiles.test.cjs apps/desktop-tauri/tests/conversations.test.cjs apps/desktop-tauri/tests/workspace-folder-groups.test.cjs apps/desktop-tauri/tests/terminal-links.test.cjs apps/desktop-tauri/tests/terminal-renderer.test.cjs apps/desktop-tauri/tests/remote-agent-composer.test.cjs apps/desktop-tauri/tests/remote-shell-composer.test.cjs apps/desktop-tauri/tests/remote-terminal-clipboard.test.cjs && cargo test --locked --offline --release --workspace --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml",
    "lint": "node apps/desktop-tauri/scripts/check-renderer-syntax.mjs && cargo fmt --all --check --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml",
    "test:ui": "node --experimental-websocket apps/desktop-tauri/tests/benchmark.cjs",
    "test:rendering": "node --experimental-websocket apps/desktop-tauri/tests/rendering.cjs",
    "test:launchers": "node --experimental-websocket apps/desktop-tauri/tests/launchers.cjs",
    "test:local-shell": "node --experimental-websocket apps/desktop-tauri/tests/local-shell-composer-ui.cjs",
    "test:remote-conversations": "node --test apps/desktop-tauri/tests/remote-conversations.test.cjs",
    "test:docker-conversations": "node --experimental-websocket apps/desktop-tauri/tests/docker-conversations-ui.cjs",
    "test:i18n": "node --experimental-websocket apps/desktop-tauri/tests/i18n-ui.cjs",
    "test:reminders": "node --experimental-websocket apps/desktop-tauri/tests/reminders.cjs",
    "test:conversations": "node --experimental-websocket apps/desktop-tauri/tests/conversations.cjs",
    "test:sidebar": "node --experimental-websocket apps/desktop-tauri/tests/workspace-sidebar.cjs",
    "test:reminder-runtime": "node --test apps/desktop-tauri/tests/reminder-runtime.test.cjs",
    "package:win": "cd apps/desktop-tauri && tauri build --bundles nsis",
    "test:runtime": "node --test apps/desktop-tauri/tests/runtime.test.cjs apps/desktop-tauri/tests/agent-hooks.test.cjs bridge/mcp/live.test.cjs",
    "mcp:server": "node bridge/mcp/server.cjs",
    "test:mcp": "node --test bridge/mcp/server.test.cjs",
    "test:lifecycle": "node --experimental-websocket apps/desktop-tauri/tests/lifecycle.cjs"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@tauri-apps/cli": "2.12.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
