{
  "name": "wincmux",
  "version": "0.1.2",
  "private": true,
  "description": "WinCMux Windows terminal workspace powered by Tauri and Rust",
  "scripts": {
    "dev": "cd apps/desktop-tauri && tauri dev",
    "build:ui": "node apps/desktop-tauri/scripts/build-ui.mjs",
    "build": "cd apps/desktop-tauri && tauri build --no-bundle",
    "pretest": "npm run build:ui",
    "test": "node --test apps/desktop-tauri/tests/adapter.test.cjs && cargo test --locked --release --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml",
    "lint": "node apps/desktop-tauri/scripts/check-renderer-syntax.mjs && cargo fmt --check --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml",
    "test:ui": "node --experimental-websocket apps/desktop-tauri/tests/benchmark.cjs",
    "package:win": "cd apps/desktop-tauri && tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/xterm": "5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
